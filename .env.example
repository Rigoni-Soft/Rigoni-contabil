# Só usada por `next dev`/`next start` e pelo Playwright (e2e) — não é validada
# em src/env.ts porque nenhum código do app a lê. Opcional; se ausente, o Next
# usa 3000 e o e2e cai no default de playwright.config.ts.
PORT=8800

# Rodar `npx supabase start` e copiar os valores impressos (API URL / anon key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role: só em `main`, nunca prefixo NEXT_PUBLIC_ (ver ADR sobre criação de conta)
SUPABASE_SERVICE_ROLE_KEY=

# Fonte das obrigações fiscais (DAS, parcelamento, CND): contrato em docs/contratos. Padrão = mock local (yarn mock:api)
OBRIGACOES_FISCAIS_URL=http://127.0.0.1:4010
# Provedor das obrigações fiscais: "mock" (padrão, usa a URL acima) ou "serpro" (Integra Contador real; exige as 5 SERPRO_*)
OBRIGACOES_FISCAIS_MODO=mock
# Ambiente do Serpro (docs/deploy/serpro.md): "trial" (demonstração, token fixo, sem certificado; padrão e Preview/homolog)
# ou "producao" (OAuth2 + e-CNPJ do escritório; Production). Vale para guias e CND.
SERPRO_AMBIENTE=trial
# Sobrescrevem as URLs padrão do ambiente (deixe vazio para usar as do SERPRO_AMBIENTE)
SERPRO_URL_AUTENTICACAO=
SERPRO_URL_INTEGRA_CONTADOR=
SERPRO_URL_CND_TOKEN=
SERPRO_URL_CND_CERTIDAO=
# Token de demonstração do trial (vazio = o da documentação do Serpro)
SERPRO_TOKEN_TRIAL=
# CNPJ do escritório (14 caracteres, sem máscara): obrigatório com OBRIGACOES_FISCAIS_MODO=serpro (no trial, use 00000000000100)
SERPRO_CNPJ_ESCRITORIO=
# Só com SERPRO_AMBIENTE=producao: Consumer Key/Secret da Área do Cliente Serpro e o certificado e-CNPJ
# do escritório (.p12 em base64, sem quebra de linha: `base64 -w0 certificado.p12`) com a senha dele
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_CERTIFICADO_P12_BASE64=
SERPRO_CERTIFICADO_SENHA=
# CND (produto avulso "Consulta CND", contrato e chave próprios): "mock" (padrão) ou "serpro"
CND_MODO=mock
# Só com SERPRO_AMBIENTE=producao e CND_MODO=serpro
SERPRO_CND_CONSUMER_KEY=
SERPRO_CND_CONSUMER_SECRET=
# Código de identificação do sistema informado na contratação (vazio no trial = 9001)
SERPRO_CND_CODIGO_IDENTIFICACAO=
# Adapter de mensageria (receber/enviar mensagens): "falso" (padrão, só registra) ou "real" (WhatsApp Cloud API; exige WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID)
MENSAGERIA_MODO=falso
# Segredos do webhook de mensageria (assinatura HMAC e token do handshake GET). Padrões falsos só pra dev:
# com NODE_ENV=production (inclusive preview da Vercel) o webhook recusa qualquer segredo ausente ou igual ao falso
MENSAGERIA_SEGREDO_ASSINATURA=segredo-falso
MENSAGERIA_TOKEN_VERIFICACAO=token-falso
# Chave do HMAC que pseudonimiza o telefone na sessão da URA (separada do segredo do webhook). Padrão falso só pra dev
MENSAGERIA_SEGREDO_SESSAO=segredo-sessao-falso
# Cloud API da Meta (só com MENSAGERIA_MODO=real): token permanente e id do número
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bearer das rotas de job (/api/jobs/*): o Vercel Cron manda este valor. Vazio = rotas recusam tudo
CRON_SECRET=
# Encerramento automático por inatividade (#73): desligada | ligada. Só ligar com mensageria real.
INATIVIDADE_AUTOMATICA=desligada

# Binário do ffmpeg que converte o áudio gravado em webm (Chrome/Edge) para ogg/opus antes de enviar
# (docs/adr/0006). Vazio = usa o do pacote `ffmpeg-static` (comprimido no build); só preencha para usar outro binário
FFMPEG_PATH=
# Lembrete de documento e envio de DAS (#52): desligada | ligada. Só ligar com mensageria real.
LEMBRETES_AUTOMATICOS=desligada

# Adapter de e-mail (#86): "falso" (padrão; em produção o canal falha explícito) ou "real" (Resend; exige RESEND_API_KEY e EMAIL_REMETENTE)
EMAIL_MODO=falso
# Chave de API do Resend com permissão "sending_access" restrita ao domínio de envio (docs/deploy/email.md)
RESEND_API_KEY=
# Remetente (domínio verificado no Resend), ex.: Rigoni Contábil <no-reply@seudominio.com.br>
EMAIL_REMETENTE=
