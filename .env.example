# Só usada por `next dev`/`next start` e pelo Playwright (e2e) — não é validada
# em src/env.ts porque nenhum código do app a lê. Opcional; se ausente, o Next
# usa 3000 e o e2e cai no default de playwright.config.ts.
PORT=8800

# Rodar `npx supabase start` e copiar os valores impressos (API URL / anon key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role: só em `main`, nunca prefixo NEXT_PUBLIC_ (ver ADR sobre criação de conta)
SUPABASE_SERVICE_ROLE_KEY=
