    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo de texto de 44px; aria-invalid troca borda e anel para destructive.",
      "html": "<input class=\"ds-input\" placeholder=\"E-mail\" />",
      "css": ".ds-input{box-sizing:border-box;width:100%;height:44px;padding:8px 12px;border:1px solid var(--input,#47453e);border-radius:4px;background:var(--background,#23221f);color:var(--foreground,#ece7d8);font:400 14px Roboto,sans-serif;outline:none;transition:border-color .15s}.ds-input:focus-visible{outline:2px solid var(--ring,#54a292);outline-offset:2px}.ds-input[aria-invalid=true]{border-color:var(--destructive,#e0968c)}"
    },
    {
      "name": "Password Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Input com botão de olho (44×44) que exibe/oculta o valor; usado no login e na troca de senha.",
      "html": "<div class=\"ds-pw\"><input class=\"ds-pw-input\" type=\"password\" value=\"abc12345\" /><button class=\"ds-pw-btn\" aria-label=\"Mostrar caracteres\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></button></div>",
      "css": ".ds-pw{position:relative}.ds-pw-input{box-sizing:border-box;width:100%;height:44px;padding:8px 44px 8px 12px;border:1px solid var(--input,#47453e);border-radius:4px;background:var(--background,#23221f);color:var(--foreground,#ece7d8);font:400 14px Roboto,sans-serif;outline:none}.ds-pw-input:focus-visible{outline:2px solid var(--ring,#54a292);outline-offset:2px}.ds-pw-btn{position:absolute;top:0;right:0;bottom:0;width:44px;display:flex;align-items:center;justify-content:center;border:0;border-radius:4px;background:transparent;color:var(--muted-foreground,#a6b3ab);cursor:pointer}.ds-pw-btn:hover{color:var(--foreground,#ece7d8)}.ds-pw-btn:focus-visible{outline:2px solid var(--ring,#54a292)}"
    },
